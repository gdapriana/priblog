{
  "openapi": "3.1.0",
  "info": {
    "title": "Priblog",
    "description": "Priblog REST API: cookie-based session authentication, blogs, and categories.\n\nAll responses use the envelope format `{ success, message, statusCode, data?, errors? }`. Authentication uses the `session` cookie (httpOnly) that is set on login.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "API Base URL"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Registration, login, logout, and user profile"
    },
    {
      "name": "Categories",
      "description": "Blog categories. Write operations are ADMIN only"
    },
    {
      "name": "Blogs",
      "description": "Blogs. Write operations require login, and only the owner can update or delete"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "operationId": "authRegister",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterBody" },
              "example": {
                "name": "John Doe",
                "email": "john@example.com",
                "password": "11111111"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registration successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/User" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "description": "On success, the server sets the `session` cookie (httpOnly, sameSite=lax, valid for 30 days and renewed automatically).",
        "operationId": "authLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginBody" },
              "example": { "email": "john@example.com", "password": "11111111" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "headers": {
              "Set-Cookie": {
                "description": "Session cookie `session=<token>; HttpOnly; Path=/; SameSite=Lax`",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/User" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, or wrong email/password",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/auth/logout": {
      "delete": {
        "tags": ["Auth"],
        "summary": "Logout",
        "description": "Deletes the session on the server and clears the `session` cookie. Safe to call even when not logged in.",
        "operationId": "authLogout",
        "responses": {
          "200": {
            "description": "Logout successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessEnvelope" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Current logged-in user profile",
        "operationId": "authMe",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user data",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/UserMe" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/categories/query": {
      "get": {
        "tags": ["Categories"],
        "summary": "List categories (cursor pagination)",
        "description": "Searches `title` and `slug` (case-insensitive). Ordering always uses `id` as a tie-breaker. Pass `nextCursor` as-is as the next `cursor` parameter. `totalData` is only returned when `withTotal=true` and `cursor` is not set.",
        "operationId": "categoryQuery",
        "parameters": [
          { "$ref": "#/components/parameters/Search" },
          { "$ref": "#/components/parameters/WithTotal" },
          { "$ref": "#/components/parameters/Take" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/SortBy" },
          { "$ref": "#/components/parameters/OrderBy" }
        ],
        "responses": {
          "200": {
            "description": "List of categories",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/CategoryList" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/categories/get": {
      "get": {
        "tags": ["Categories"],
        "summary": "Get a single category by id or slug",
        "operationId": "categoryGet",
        "parameters": [
          { "$ref": "#/components/parameters/GetBy" },
          { "$ref": "#/components/parameters/GetValue" }
        ],
        "responses": {
          "200": {
            "description": "Category found",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/Category" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/categories": {
      "post": {
        "tags": ["Categories"],
        "summary": "Create a category (ADMIN)",
        "description": "The slug is generated automatically from `title`. The body is strict: properties outside the schema are rejected.",
        "operationId": "categoryCreate",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CategoryCreateBody" },
              "example": { "title": "Technology" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Category created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/IdOnly" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/UnauthorizedOrNotAdmin" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/categories/{categoryId}": {
      "parameters": [
        {
          "name": "categoryId",
          "in": "path",
          "required": true,
          "description": "Category ID",
          "schema": { "type": "integer" }
        }
      ],
      "patch": {
        "tags": ["Categories"],
        "summary": "Update a category (ADMIN)",
        "description": "All fields are optional. If `title` is sent, the slug is regenerated from the new title.",
        "operationId": "categoryUpdate",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CategoryUpdateBody" },
              "example": { "title": "Technology and Science" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Category updated",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/IdOnly" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/UnauthorizedOrNotAdmin" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "summary": "Delete a category (ADMIN)",
        "operationId": "categoryDelete",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Category deleted",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/IdOnly" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/UnauthorizedOrNotAdmin" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/blogs/query": {
      "get": {
        "tags": ["Blogs"],
        "summary": "List blogs (cursor pagination)",
        "description": "Searches `title` and `slug`. Each item includes `category` and `user` (may be `null`). `userId` filters blogs owned by a single user. `totalData` is only returned when `withTotal=true` and `cursor` is not set.",
        "operationId": "blogQuery",
        "parameters": [
          { "$ref": "#/components/parameters/Search" },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "Only return blogs owned by this user",
            "schema": { "type": "integer" }
          },
          { "$ref": "#/components/parameters/WithTotal" },
          { "$ref": "#/components/parameters/Take" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/SortBy" },
          { "$ref": "#/components/parameters/OrderBy" }
        ],
        "responses": {
          "200": {
            "description": "List of blogs",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/BlogList" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/blogs/get": {
      "get": {
        "tags": ["Blogs"],
        "summary": "Get a single blog by id or slug",
        "operationId": "blogGet",
        "parameters": [
          { "$ref": "#/components/parameters/GetBy" },
          { "$ref": "#/components/parameters/GetValue" }
        ],
        "responses": {
          "200": {
            "description": "Blog found",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/Blog" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/blogs": {
      "post": {
        "tags": ["Blogs"],
        "summary": "Create a blog",
        "description": "The blog owner (`userId`) is taken from the login session, and the slug is generated automatically from `title`. The body is strict: properties outside the schema are rejected.",
        "operationId": "blogCreate",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BlogCreateBody" },
              "example": {
                "title": "Learning Drizzle ORM",
                "excerpt": "Short summary",
                "content": "Full blog content...",
                "categoryId": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Blog created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/IdOnly" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/blogs/{blogId}": {
      "parameters": [
        {
          "name": "blogId",
          "in": "path",
          "required": true,
          "description": "Blog ID",
          "schema": { "type": "integer" }
        }
      ],
      "patch": {
        "tags": ["Blogs"],
        "summary": "Update a blog (owner only)",
        "description": "All fields are optional. If `title` is sent, the slug is regenerated. Returns 403 if the blog does not belong to the logged-in user.",
        "operationId": "blogUpdate",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BlogUpdateBody" },
              "example": { "title": "New title", "excerpt": "New summary" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Blog updated",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/IdOnly" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Blogs"],
        "summary": "Delete a blog (owner only)",
        "description": "Returns 403 if the blog does not belong to the logged-in user.",
        "operationId": "blogDelete",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Blog deleted",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/IdOnly" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "Session cookie set by `POST /auth/login`"
      }
    },
    "parameters": {
      "Search": {
        "name": "search",
        "in": "query",
        "required": false,
        "description": "Search keyword matched against title and slug",
        "schema": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "WithTotal": {
        "name": "withTotal",
        "in": "query",
        "required": false,
        "description": "Include `totalData` (only applies when `cursor` is empty)",
        "schema": {
          "type": "string",
          "enum": ["true", "false"],
          "default": "false"
        }
      },
      "Take": {
        "name": "take",
        "in": "query",
        "required": false,
        "description": "Number of items per page",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "The `nextCursor` value from the previous response. A malformed cursor returns 400",
        "schema": { "type": "string", "maxLength": 500 }
      },
      "SortBy": {
        "name": "sortBy",
        "in": "query",
        "required": false,
        "description": "Sort column",
        "schema": {
          "type": "string",
          "enum": ["id", "title", "createdAt"],
          "default": "id"
        }
      },
      "OrderBy": {
        "name": "orderBy",
        "in": "query",
        "required": false,
        "description": "Sort direction",
        "schema": {
          "type": "string",
          "enum": ["desc", "asc"],
          "default": "desc"
        }
      },
      "GetBy": {
        "name": "by",
        "in": "query",
        "required": true,
        "description": "Lookup column",
        "schema": { "type": "string", "enum": ["id", "slug"] }
      },
      "GetValue": {
        "name": "value",
        "in": "query",
        "required": true,
        "description": "The id (number) or slug, depending on `by`",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Validation failed (body/query/param does not match the schema)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ValidationErrorEnvelope" }
          }
        }
      },
      "Unauthorized": {
        "description": "Not logged in, or the session is invalid",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "success": false,
              "message": "You must be logged in to access this resource",
              "statusCode": 401
            }
          }
        }
      },
      "UnauthorizedOrNotAdmin": {
        "description": "Not logged in, or the user is not an ADMIN (the server currently also uses 401 for a mismatched role)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "success": false,
              "message": "You must be logged in to access this resource",
              "statusCode": 401
            }
          }
        }
      },
      "Forbidden": {
        "description": "No permission (not the resource owner)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "success": false,
              "message": "You don't have permission to access this resource",
              "statusCode": 403
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "success": false,
              "message": "blog not found",
              "statusCode": 404
            }
          }
        }
      },
      "Conflict": {
        "description": "Data already exists (duplicate email or slug)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "success": false,
              "message": "Email is already registered",
              "statusCode": 409
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "success": false,
              "message": "Internal server error",
              "statusCode": 500
            }
          }
        }
      }
    },
    "schemas": {
      "SuccessEnvelope": {
        "type": "object",
        "required": ["success", "message", "statusCode"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "message": {
            "type": "string",
            "examples": ["blog fetched successfully"]
          },
          "statusCode": { "type": "integer", "examples": [200] },
          "data": {}
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["success", "message", "statusCode"],
        "properties": {
          "success": { "type": "boolean", "const": false },
          "message": { "type": "string" },
          "statusCode": { "type": "integer" },
          "errors": {},
          "stack": {
            "type": "string",
            "description": "Only present when NODE_ENV=development"
          }
        }
      },
      "ValidationErrorEnvelope": {
        "type": "object",
        "required": ["success", "message", "statusCode", "errors"],
        "properties": {
          "success": { "type": "boolean", "const": false },
          "message": { "type": "string", "examples": ["Validation error"] },
          "statusCode": { "type": "integer", "examples": [400] },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "examples": ["title"] },
                "message": {
                  "type": "string",
                  "examples": [
                    "Invalid input: expected string, received undefined"
                  ]
                },
                "code": { "type": "string", "examples": ["invalid_type"] }
              }
            }
          }
        }
      },
      "IdOnly": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "integer", "examples": [1] } }
      },
      "Role": {
        "type": "string",
        "enum": ["ADMIN", "USER"]
      },
      "User": {
        "type": "object",
        "required": ["id", "name", "email", "role", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "maxLength": 255 },
          "email": { "type": "string", "format": "email", "maxLength": 255 },
          "role": { "$ref": "#/components/schemas/Role" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "UserMe": {
        "type": "object",
        "required": ["id", "name", "email", "role"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "$ref": "#/components/schemas/Role" }
        }
      },
      "Category": {
        "type": "object",
        "required": ["id", "title", "slug", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "integer" },
          "slug": { "type": ["string", "null"], "maxLength": 500 },
          "title": { "type": "string", "maxLength": 300 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "CategorySummary": {
        "type": "object",
        "required": ["id", "title", "slug"],
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "slug": { "type": ["string", "null"] }
        }
      },
      "UserSummary": {
        "type": "object",
        "required": ["id", "name", "email"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "Blog": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "categoryId",
          "slug",
          "title",
          "excerpt",
          "content",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "integer" },
          "userId": { "type": ["integer", "null"] },
          "categoryId": { "type": ["integer", "null"] },
          "slug": { "type": ["string", "null"], "maxLength": 500 },
          "title": { "type": "string", "maxLength": 300 },
          "excerpt": { "type": ["string", "null"] },
          "content": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "BlogWithRelations": {
        "allOf": [
          { "$ref": "#/components/schemas/Blog" },
          {
            "type": "object",
            "required": ["category", "user"],
            "properties": {
              "category": {
                "oneOf": [
                  { "$ref": "#/components/schemas/CategorySummary" },
                  { "type": "null" }
                ]
              },
              "user": {
                "oneOf": [
                  { "$ref": "#/components/schemas/UserSummary" },
                  { "type": "null" }
                ]
              }
            }
          }
        ]
      },
      "PageMeta": {
        "type": "object",
        "required": ["nextCursor", "hasMore"],
        "properties": {
          "nextCursor": {
            "type": ["string", "null"],
            "description": "Cursor for the next page; `null` when there are no more pages"
          },
          "hasMore": { "type": "boolean" },
          "totalData": {
            "type": "integer",
            "description": "Total number of records matching the `search` filter. Only present when `withTotal=true` and no `cursor` is given"
          }
        }
      },
      "CategoryList": {
        "allOf": [
          { "$ref": "#/components/schemas/PageMeta" },
          {
            "type": "object",
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Category" }
              }
            }
          }
        ]
      },
      "BlogList": {
        "allOf": [
          { "$ref": "#/components/schemas/PageMeta" },
          {
            "type": "object",
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/BlogWithRelations" }
              }
            }
          }
        ]
      },
      "RegisterBody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "email": { "type": "string", "format": "email", "maxLength": 200 },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1000,
            "format": "password"
          }
        }
      },
      "LoginBody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 200 },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "format": "password"
          }
        }
      },
      "CategoryCreateBody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "maxLength": 300 },
          "slug": {
            "type": ["string", "null"],
            "maxLength": 500,
            "description": "Accepted by validation, but the server always overwrites it with the slug generated from `title`"
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "CategoryUpdateBody": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "maxLength": 300 },
          "slug": {
            "type": ["string", "null"],
            "maxLength": 500,
            "description": "Overwritten with the slug generated from `title` when `title` is sent"
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "BlogCreateBody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "maxLength": 300 },
          "excerpt": { "type": ["string", "null"] },
          "content": { "type": ["string", "null"] },
          "categoryId": {
            "type": ["integer", "null"],
            "description": "Category ID"
          },
          "slug": {
            "type": ["string", "null"],
            "maxLength": 500,
            "description": "Accepted by validation, but the server always overwrites it with the slug generated from `title`"
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "BlogUpdateBody": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "maxLength": 300 },
          "excerpt": { "type": ["string", "null"] },
          "content": { "type": ["string", "null"] },
          "categoryId": {
            "type": ["integer", "null"],
            "description": "Category ID"
          },
          "slug": {
            "type": ["string", "null"],
            "maxLength": 500,
            "description": "Overwritten with a new slug when `title` is sent"
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}
